# Mac seat @ 2b79e0a1f (the build the reference set v2 was cut on).
# EVERY claude_* dial is set explicitly: several read 0 when unset
# (readRadiance/readFaceTexels return 0/1 if the setting does not
# exist), so an incomplete conf silently disables features.
name = claude
address = 127.0.0.1
remote_port = 30000
screen_w = 1920
screen_h = 1080
fullscreen = false
invert_mouse = true
fast_move = true
free_move = true
viewing_range = 120
enable_dynamic_shadows = false
enable_bloom = false
enable_auto_exposure = false
enable_volumetric_lighting = false
enable_water_reflections = false
tone_mapping = false
undersampling = 1
fsaa = 0
debug_log_level = info
default_privs = interact, shout, fly, fast, noclip, teleport, settime, privs, give, debug, server

# --- traced pipeline master switch (0 = raster pass-through, 3 = traced)
claude_volume_debug = 3
claude_stats = 1
# --- console -> client dial channel: /dial in-game writes here, polled by
# pollSettingsPatch() alongside claude_settings_patch.conf (~1 Hz)
claude_dial_file = worlds/gallery/claude_dial.conf

# --- PURE-1M PHOTO (dials.md config of record)
claude_cascades = 0
claude_refine = 1
claude_trace_scale = 1.0
claude_face_direct = 0
claude_tiers = 0
claude_light_ladder = 0
claude_subvox = 0
claude_denoise = 0

# --- the six that were silently OFF all session (ship values)
claude_radiance = 1
claude_face_texels = 2
claude_pyramid = 1
claude_cache_remap = 1
claude_far_hist = 1
claude_cache_sky = 1

# --- no cheats
ssao_strength = 0
claude_bisect = 0
claude_cost = 0
claude_bounce2 = 0
claude_bounce_stride = 1
claude_nee_gate = 0

# --- lab resolution, PINNED (2026-08-15) ---------------------------------
# Luanti saves the window size back to the conf on exit; one manual
# resize breaks pixel comparison against every golden. claude_ci.py
# forces these before each run; keep them here so manual seats match.
screen_w = 1920
screen_h = 1080
fullscreen = false
window_maximized = false
autosave_screensize = false

# --- fps cap, PINNED (2026-08-15) ----------------------------------------
# environment-laws "Measurement traps": FpsControl::limit sleeps to
# fps_max when the window is focused and fps_max_unfocused when it is
# not (renderingengine.cpp) — and BOTH have hidden defaults (60 / 10,
# defaultsettings.cpp), so a conf with no line here is a conf with a cap.
# The sleep lands in dtime and therefore in frame_ms_avg, so a capped
# run reads as a slower RENDERER; this has twice been mistaken for a
# performance collapse. Neither key was pinned anywhere until today —
# the seat conf of record and claude_ci.pin_conf both omitted them, so
# every headless run inherited whatever the client last saved (10).
# 200 is above anything this renderer reaches, i.e. no sleep at all.
# The lab seat pins both; John's own client may keep a low cap.
fps_max = 200
fps_max_unfocused = 200
